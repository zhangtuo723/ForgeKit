# Copy to .env.local. Do not commit real credentials.
# Application login accounts are stored in MySQL with salted scrypt hashes.
# Do not add an admin login password here. Initialize or reset accounts with
# scripts/set-admin.mjs --username <name> --password-stdin (see README).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=forge_studio
MYSQL_USER=forge_studio_app
MYSQL_PASSWORD="replace-with-your-database-password"

# SSH already encrypts local development traffic. For direct TLS use true
# and optionally MYSQL_SSL_CA_FILE=/path/to/mysql-ca.pem.
MYSQL_SSL=false
# Legacy local image backups and migration input; new images are stored in COS.
FORGE_DATA_DIR=./data

# Server-side COS credentials only. Never use a NEXT_PUBLIC_ prefix for secrets.
# Local and deployed applications use the same bucket, prefix and MySQL metadata.
COS_BUCKET=test-1301661941
COS_REGION=ap-nanjing
COS_PREFIX=forge-studio/
COS_SECRET_ID="replace-with-your-cos-secret-id"
COS_SECRET_KEY="replace-with-your-cos-secret-key"
# Optional, only when using temporary credentials:
# COS_SESSION_TOKEN="replace-with-your-security-token"
# Integration tests must also use MYSQL_DATABASE=forge_studio_test and a unique
# COS_PREFIX=forge-studio/_qa/<run>/ in BOTH the app process and the test process.

# Local development only: optional SSH tunnel to the remote MySQL service.
# Remove these options when the app runs on the database server itself.
# DB_TUNNEL_HOST=your-server-host
# DB_TUNNEL_PORT=22
# DB_TUNNEL_USER=forge_tunnel
# DB_TUNNEL_KEY_FILE=C:/Users/you/.ssh/forge_studio_mysql_ed25519
# DB_TUNNEL_KNOWN_HOSTS_FILE=C:/Users/you/.ssh/forge_studio_mysql_known_hosts

# On the database server, MYSQL_PORT should be 3306.
# For public application hosting behind nginx, set the exact HTTPS origin.
# Keep this origin-only: Studio pages use /studio/* and APIs /api/studio/*.
# Do not append /studio or /api/studio to FORGE_APP_URL or QA API_BASE_URL.
# FORGE_APP_URL=https://forgekit.cn
